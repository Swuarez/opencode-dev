+function run(file: string, args: string[], timeout = 20_000) {
+  return new Promise<{ ok: boolean; out: string }>((resolve) => {
+    execFile(file, args, { timeout, windowsHide: true }, (error, stdout, stderr) =>
+      resolve({ ok: !error, out: `${stdout}${stderr}` }),
+    )
+  })
+}
