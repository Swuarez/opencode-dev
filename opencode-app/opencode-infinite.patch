+/** Polls every 400 ms for up to 30 s, so the answer lands as soon as WARP is up. */
+async function waitProxy() {
+  for (let i = 0; i < 75; i++) {
+    const found = await trace()
+    if (found?.ip) return found
+    await sleep(400)
+  }
+  return undefined
+}
