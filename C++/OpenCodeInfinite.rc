 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "jekooo"
            VALUE "FileDescription", "opencode-infinity"
            VALUE "FileVersion", "3.4.4.0"
            VALUE "InternalName", "OpenCodeInfinite"
            VALUE "OriginalFilename", "OpenCodeInfinite.exe"
            VALUE "ProductName", "opencode-infinity"
            VALUE "ProductVersion", "3.4.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
