[Unit]
Description=OpenCode Infinite egress rotator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=egress
EnvironmentFile=/etc/egress-rotator.env
ExecStart=/usr/bin/node /opt/egress-rotator/rotator.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/egress-rotator

[Install]
WantedBy=multi-user.target
